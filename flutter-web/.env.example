# Copy to .env and fill in. The app reads this file at startup.
# .env is not committed. There is no field for these in the boat profile.
#   flutter run -d chrome --dart-define-from-file=.env
#
# In production these come from Netlify's own site env vars (Site configuration
# > Environment variables), not this file — set CARTO_KEY and MAPLIBRE_STYLE_URL
# there too, scoped to the flutter branch's build context.

CARTO_KEY=
MAPLIBRE_STYLE_URL=
